{
  "version": "1.0",
  "collections": [
    {
      "collection": "codes",
      "root_table": "CODES",
      "key": {
        "source": [
          "CODE_VAL"
        ],
        "target": "_id"
      },
      "fields": [
        {
          "source": "CODE_TYPE",
          "target": "code_type",
          "source_type": "VARCHAR2",
          "bson_type": "string",
          "rules": [
            "empty_string_is_null"
          ]
        },
        {
          "source": "CODE_DESC",
          "target": "code_desc",
          "source_type": "VARCHAR2",
          "bson_type": "string",
          "rules": [
            "empty_string_is_null"
          ]
        }
      ],
      "root_where": "CODE_TYPE = '${code_type}'"
    }
  ]
}
