{
  "unit": "bronze_core",
  "job_name": "ow_tp_bronze_core",
  "catalog": "ow_tp",
  "schema": "bronze",
  "source_schema": "OW_BILLING",
  "source_artifact": "services/legacy-billing/db/oracle/schema/01_tables.sql",
  "quarantine_table": "quarantine_bronze_core",
  "quarantine_reasons": [
    "BAD_DATE",
    "DATE_INVALID",
    "AMT_NON_NUMERIC",
    "RECORD_SHORT",
    "ENC_INVALID",
    "KEY_NULL",
    "KEY_DUPLICATE",
    "FK_ORPHAN",
    "CODE_UNKNOWN",
    "NUMERIC_OVERFLOW"
  ],
  "class_target_types": {
    "text": "STRING",
    "flag": "STRING",
    "code": "INT",
    "count": "DECIMAL(38,0)",
    "money": "DECIMAL(14,2)",
    "rate": "DECIMAL(12,6)",
    "surrogate": "DECIMAL(38,0)",
    "date": "TIMESTAMP",
    "ts": "TIMESTAMP"
  },
  "extract_formats": {
    "date": "YYYY-MM-DD HH24:MI:SS",
    "ts": "YYYY-MM-DD HH24:MI:SS.FF6"
  },
  "code_checks": [
    {
      "table": "usage_events",
      "column": "kind_cd",
      "code_type": "USAGE_KIND",
      "reason": "CODE_UNKNOWN",
      "source": "trg_usage_events_check"
    }
  ],
  "positive_checks": [
    {
      "table": "usage_events",
      "column": "units",
      "source": "trg_usage_events_check",
      "note": "Source trigger rejects units <= 0. No quarantine reason in the closed set covers it, so a non-zero count halts the unit for central triage instead of being folded into another code."
    }
  ],
  "frozen_status": [
    {
      "table": "subscriptions",
      "column": "status_cd",
      "value": 30,
      "source": "trg_sub_no_uncancel",
      "note": "A cancelled subscription can never leave status 30, so the MERGE never updates status_cd away from 30 on an existing row."
    }
  ],
