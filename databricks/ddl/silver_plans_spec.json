    "KEY_NULL",
    "KEY_DUPLICATE",
    "FK_ORPHAN",
    "NUMERIC_OVERFLOW"
  ],
  "quarantine_halt_threshold_pct": 5.0,
  "quarantine_halt_basis": "subscription driver: one row per source OW_BILLING.SUBSCRIPTIONS row in ns plus one row per declared plan-change request this run applies — numerator and denominator on that one population",
  "plans_constants": {
    "tier_map": {
      "1": "starter",
      "2": "growth",
      "3": "scale"
    },
    "tier_default": "UNKNOWN",
    "status_map": {
      "10": "active",
      "20": "suspended",
      "30": "cancelled"
    },
    "status_default": "UNKNOWN",
    "active_flag": "Y",
    "inactive_nvl_default": "N",
    "sentinel_end_date": "2099-12-31",
    "sentinel_literal": "TO_DATE('31-DEC-99', 'DD-MON-YY')",
    "active_status_cd": 10,
    "suspended_status_cd": 20,
    "cancelled_status_cd": 30,
    "list_order_by": [
      "monthly_fee",
      "code"
    ],
    "covering_pick_order_by": [
      "starts_on DESC",
      "id DESC"
    ],
    "closeout_order_by": [
      "tenant_id",
      "starts_on",
      "id"
    ],
    "global_iteration_order_by": [
      "tenant_id"
    ]
  },
  "change_requests": {
    "population_is_a_declared_job_input": true,
    "note": "The source has no change-request table: sp_change_plan is called by the application with (p_tenant_id, p_plan_id, p_effective_on). The run's population is therefore declared here and derived deterministically from bronze so both sides of the recon can build the identical set independently.",
    "derivation": "one request per tenant that has a covering subscription on entitlement_on: p_plan_id is the next plan after the tenant's covering plan in fn_list_plans order (monthly_fee, code) over the active plans, cyclically; p_effective_on is change_effective_on. A tenant with no covering subscription gets no request.",
    "default_effective_on": "2026-03-01",
    "overrides_are_pinned_from_transcripts": [
      {
        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "plan_id": "10000000-0000-0000-0000-000000000002",
        "effective_on": "2026-03-01",
        "transcript": "PLANS-004"
      },
      {
        "tenant_id": "00000000-0000-0000-0000-000000000004",
        "plan_id": "10000000-0000-0000-0000-000000000003",
        "effective_on": "2026-03-15",
        "transcript": "PLANS-005"
      }
    ]
  },
  "entitlement_on": "2026-02-28",
