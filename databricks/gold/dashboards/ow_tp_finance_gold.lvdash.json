                  "fields": [{ "name": "sum(arr)", "expression": "SUM(`arr`)" }],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": { "title": "ARR (run rate)", "showTitle": true },
              "encodings": {
                "value": {
                  "fieldName": "sum(arr)",
                  "displayName": "ARR",
                  "format": { "type": "number-currency", "currencyCode": "USD", "decimalPlaces": { "type": "exact", "places": 0 } }
                }
