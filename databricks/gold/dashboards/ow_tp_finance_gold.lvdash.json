{
  "datasets": [
    {
      "name": "ds_revenue_totals",
      "displayName": "Revenue totals",
      "queryLines": [
        "SELECT MEASURE(`ARR`) AS arr,\n",
        "       MEASURE(`MRR`) AS mrr,\n",
        "       MEASURE(`Active Subscriptions`) AS active_subscriptions,\n",
        "       MEASURE(`Paying Tenants`) AS paying_tenants,\n",
        "       MEASURE(`ARPA`) AS arpa\n",
        "FROM mv_arr_mrr"
      ]
    },
    {
      "name": "ds_mrr_by_plan",
      "displayName": "MRR by plan",
      "queryLines": [
        "SELECT `Plan` AS plan,\n",
        "       MEASURE(`MRR`) AS mrr,\n",
        "       MEASURE(`ARR`) AS arr,\n",
        "       MEASURE(`Active Subscriptions`) AS active_subscriptions\n",
        "FROM mv_arr_mrr\n",
        "WHERE `Counts Towards MRR`\n",
        "GROUP BY ALL\n",
        "ORDER BY 2 DESC"
      ]
    },
    {
      "name": "ds_ar_totals",
      "displayName": "AR totals",
      "queryLines": [
        "SELECT MEASURE(`Open Balance`) AS open_balance,\n",
        "       MEASURE(`Open Invoices`) AS open_invoices,\n",
        "       MEASURE(`Balance Past Due`) AS balance_past_due,\n",
        "       MEASURE(`Balance With Unknown Ageing`) AS balance_unknown_ageing,\n",
        "       MEASURE(`Average Days Past Due`) AS avg_days_past_due\n",
        "FROM mv_ar_ageing"
      ]
    },
    {
      "name": "ds_ar_ageing",
      "displayName": "AR ageing buckets",
      "queryLines": [
        "SELECT `Ageing Bucket` AS ageing_bucket,\n",
        "       MEASURE(`Open Balance`) AS open_balance,\n",
        "       MEASURE(`Open Invoices`) AS open_invoices\n",
        "FROM mv_ar_ageing\n",
        "GROUP BY ALL\n",
        "ORDER BY 1"
      ]
    },
    {
      "name": "ds_ar_top_customers",
      "displayName": "AR by customer",
      "queryLines": [
        "SELECT `Customer` AS customer,\n",
        "       MEASURE(`Open Balance`) AS open_balance,\n",
        "       MEASURE(`Balance Past Due`) AS balance_past_due,\n",
        "       MEASURE(`Open Invoices`) AS open_invoices\n",
        "FROM mv_ar_ageing\n",
        "GROUP BY ALL\n",
        "ORDER BY 2 DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "ds_overage_totals",
      "displayName": "Overage totals",
      "queryLines": [
        "SELECT MEASURE(`Overage Amount`) AS overage_amount,\n",
        "       MEASURE(`Billable Units`) AS billable_units,\n",
        "       MEASURE(`Used Units`) AS used_units,\n",
        "       MEASURE(`Entitled Units`) AS entitled_units,\n",
        "       MEASURE(`Tenants Over Entitlement`) AS tenants_over,\n",
        "       MEASURE(`Unrateable Periods`) AS unrateable_periods\n",
        "FROM mv_overage"
      ]
    },
    {
      "name": "ds_overage_by_plan",
      "displayName": "Overage by plan",
      "queryLines": [
        "SELECT `Plan` AS plan,\n",
        "       MEASURE(`Overage Amount`) AS overage_amount,\n",
        "       MEASURE(`Used Units`) AS used_units,\n",
        "       MEASURE(`Entitled Units`) AS entitled_units,\n",
        "       MEASURE(`Tenants Over Entitlement`) AS tenants_over\n",
        "FROM mv_overage\n",
        "GROUP BY ALL\n",
        "ORDER BY 2 DESC"
      ]
    },
    {
      "name": "ds_overage_top_tenants",
      "displayName": "Tenants over entitlement",
      "queryLines": [
        "SELECT `Tenant` AS tenant,\n",
        "       `Plan` AS plan,\n",
        "       MEASURE(`Used Units`) AS used_units,\n",
        "       MEASURE(`Entitled Units`) AS entitled_units,\n",
        "       MEASURE(`Billable Units`) AS billable_units,\n",
        "       MEASURE(`Overage Amount`) AS overage_amount\n",
        "FROM mv_overage\n",
        "GROUP BY ALL\n",
        "ORDER BY 6 DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_storage_totals",
      "displayName": "Storage totals",
      "queryLines": [
        "SELECT MEASURE(`Allocated Storage Cost`) AS allocated_storage_cost,\n",
        "       MEASURE(`Storage Cost At List`) AS storage_cost_at_list,\n",
        "       MEASURE(`Storage Units`) AS storage_units,\n",
        "       MEASURE(`Storage Share`) AS storage_share\n",
        "FROM mv_storage_cost"
      ]
    },
    {
      "name": "ds_storage_top_tenants",
      "displayName": "Storage cost by tenant",
      "queryLines": [
        "SELECT `Tenant` AS tenant,\n",
        "       `Plan` AS plan,\n",
        "       MEASURE(`Storage Units`) AS storage_units,\n",
        "       MEASURE(`Allocated Storage Cost`) AS allocated_storage_cost,\n",
        "       MEASURE(`Storage Cost At List`) AS storage_cost_at_list\n",
        "FROM mv_storage_cost\n",
        "GROUP BY ALL\n",
        "ORDER BY 4 DESC\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_dq",
      "displayName": "Data quality exceptions",
      "queryLines": [
        "SELECT rule_name,\n",
        "       metric_treatment,\n",
        "       COUNT(*) AS exception_rows,\n",
        "       SUM(amount_at_risk) AS amount_at_risk\n",
        "FROM dq_exceptions\n",
        "GROUP BY ALL\n",
        "ORDER BY 3 DESC"
      ]
    }
  ],
  "pages": [
    {
      "name": "finance_overview",
      "displayName": "Finance overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "header",
            "multilineTextboxSpec": {
              "lines": [
                "# OtterWorks finance — gold layer\n",
                "\n",
                "Every number here comes from a Unity Catalog metric view over `ow_tp.gold`, so the definition travels with the metric instead of living in a spreadsheet. **ARR/MRR** counts a subscription when it is active, its period covers the as-of moment, and it is the tenant's latest-starting subscription; credit notes do not reduce it. **AR ageing** buckets the open invoice header balance by days past due, and keeps unparseable dates in an `unknown` bucket rather than dropping the money. **Overage** and **storage cost** follow the legacy rating rules, including the 101-unit tier break. The data-quality panel at the bottom is the audit trail: every source row the layer could not take at face value, with what the metric did about it."
              ]
            }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 4 }
        },
        {
          "widget": {
            "name": "kpi_arr",
            "queries": [
              {
                "name": "main_query",
                "query": {
