# Copy to .env (git-ignored). These feed Airflow Connections / Variables via
# docker-compose.yml. Never commit real values.

# aws_default Connection (S3Hook / SqsHook / DynamoDBHook)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# Uncomment to target the repo's LocalStack instead of AWS:
# AWS_ENDPOINT_URL=http://host.docker.internal:4566

# otterworks_postgres Connection (PostgresHook -> analytics_daily_summary)
OTTERWORKS_DB_HOST=host.docker.internal
OTTERWORKS_DB_PORT=5432
OTTERWORKS_DB_NAME=otterworks_analytics
OTTERWORKS_DB_USER=
OTTERWORKS_DB_PASSWORD=

# Airflow Variables (non-sensitive)
OTTERWORKS_DATA_LAKE_BUCKET=otterworks-data-lake
OTTERWORKS_FILE_STORAGE_BUCKET=otterworks-file-storage
OTTERWORKS_QUARANTINE_BUCKET=otterworks-file-quarantine
OTTERWORKS_ANALYTICS_PREFIX=analytics/daily
OTTERWORKS_ANALYTICS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/otterworks-analytics
OTTERWORKS_ANALYTICS_EVENTS_TABLE=otterworks-analytics-events
OTTERWORKS_FILE_METADATA_TABLE=otterworks-file-metadata
OTTERWORKS_ANALYTICS_SQS_MAX_MESSAGES=10000

OTTERWORKS_ALERT_EMAIL=data-team@otterworks.dev
AIRFLOW_UID=50000

# Airflow UI login created by `docker compose up airflow-init` (required, no default).
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
# Shared secret signing the tokens between scheduler/workers and the api-server
# (required, no default): e.g. `openssl rand -hex 32`.
AIRFLOW_JWT_SECRET=
# Optional Fernet key for DB-stored Connections/Variables (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
AIRFLOW_FERNET_KEY=
