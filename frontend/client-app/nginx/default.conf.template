map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /api/health {
        default_type application/json;
        return 200 '{"status":"healthy","service":"web-app"}';
    }

    # Proxy /api/v1/* to the API gateway (same-origin, no CORS), replacing the
    # old Next.js middleware rewrite. The full request path is passed through.
    location /api/v1/ {
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # One prefix and one env var per portal bounded context: the prefix is stripped, so the
    # backend sees its own /api/* path unchanged, and the env var selects the backend — the
    # extracted service by default, the legacy monolith on rollback. Changing the var and
    # restarting the container is the whole switch; see docs/migration/traffic-routing.md.
    #
    # The target is held in a variable so nginx resolves it per request through the container
    # DNS resolver instead of at startup: a context whose backend is not deployed yet must not
    # stop the app from booting.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    location /announcements-api/ {
        set $announcements_backend ${ANNOUNCEMENTS_API_URL};
        rewrite ^/announcements-api/(.*)$ /$1 break;
        proxy_pass $announcements_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /user-preferences-api/ {
        set $user_preferences_backend ${USER_PREFERENCES_API_URL};
        rewrite ^/user-preferences-api/(.*)$ /$1 break;
        proxy_pass $user_preferences_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /feedback-api/ {
        set $feedback_backend ${FEEDBACK_API_URL};
        rewrite ^/feedback-api/(.*)$ /$1 break;
        proxy_pass $feedback_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
