{
  "id": null,
  "uid": "critical-api-slo",
  "title": "Critical API SLOs",
  "description": "Per-endpoint availability and latency SLOs for the APIs listed in observability/slo/critical-apis.yaml. Generated by observability/slo/generate.py; do not edit in Grafana.",
  "tags": [
    "otterworks",
    "slo",
    "critical-api"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Endpoints burning error budget now",
      "type": "stat",
      "description": "Critical endpoints currently consuming their error budget at the fast burn rate. Anything above zero is a page in flight or about to fire.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count(\n  slo:api_request_errors:ratio_rate1h\n    > on (backend, method, route) group_left ()\n  (14.4 * (1 - slo:api_endpoint:availability_objective))\n) or vector(0)",
          "legendFormat": "endpoints"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Failing synthetic probes",
      "type": "stat",
      "description": "Synthetic checks run every 30s regardless of user traffic, so an outage with no requests still shows up here.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"blackbox-critical-api\"} == 0) or vector(0)",
          "legendFormat": "probes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Error budget remaining (30d)",
      "type": "bargauge",
      "description": "Fraction of the 30d availability error budget still unspent.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sort(slo:api_error_budget:remaining_ratio)",
          "legendFormat": "{{ method }} {{ route }}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Availability SLI vs objective",
      "type": "timeseries",
      "description": "Rolling 1h success ratio per critical endpoint against its objective.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "1 - slo:api_request_errors:ratio_rate1h",
          "legendFormat": "{{ method }} {{ route }}"
        },
        {
          "expr": "slo:api_endpoint:availability_objective",
          "legendFormat": "objective {{ method }} {{ route }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "title": "Latency SLI: requests over budget (1h)",
      "type": "timeseries",
      "description": "Share of requests slower than the endpoint's latency threshold, compared with the share the objective permits.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "slo:api_request_latency:bad_ratio_rate1h",
          "legendFormat": "{{ method }} {{ route }}"
        },
        {
          "expr": "1 - slo:api_endpoint:latency_objective",
          "legendFormat": "budget {{ method }} {{ route }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "title": "Availability burn rate (1h)",
      "type": "timeseries",
      "description": "Budget consumption multiplier. 1x spends the whole 30d budget in exactly 30d; 14.4x is the fast-burn page threshold.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "slo:api_request_errors:ratio_rate1h\n  / on (backend, method, route) group_left ()\n(1 - slo:api_endpoint:availability_objective)",
          "legendFormat": "{{ method }} {{ route }}"
        }
      ]
    },
    {
      "title": "Request rate by critical endpoint",
      "type": "timeseries",
      "description": "Traffic per endpoint; a drop to zero fires CriticalApiNoTraffic.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "slo:api_request:rate5m",
          "legendFormat": "{{ method }} {{ route }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "title": "Synthetic probe success",
      "type": "state-timeline",
      "description": "Blackbox health probe results per backend service.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-critical-api\"}",
          "legendFormat": "{{ probe_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "title": "Synthetic probe duration",
      "type": "timeseries",
      "description": "End-to-end probe latency through the shared ingress and gateway.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"blackbox-critical-api\"}",
          "legendFormat": "{{ probe_id }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s"
}
