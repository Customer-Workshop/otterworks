# systemd unit for running legacy-portal on a VM / on-prem host.
#
# This is the "runs on a VM today" deployment of the post-decomposition shell: it serves
# /health and the actuator endpoints and needs no database. See docs/migration/decommission.md
# for how the unit is drained and removed.
#
# Install:
#   sudo useradd -r -s /usr/sbin/nologin legacyportal || true
#   sudo mkdir -p /opt/legacy-portal && sudo cp target/legacy-portal.jar /opt/legacy-portal/
#   sudo cp deploy/legacy-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now legacy-portal
#
# Optional operator-managed branding settings (defaults to the packaged copy; the working
# directory is never searched). The file must be root-owned and not writable by the service
# user, since its values are served on the unauthenticated /health endpoint:
#   ExecStart=... -Dportal.settings.path=/etc/legacy-portal/portal-settings.properties ...
[Unit]
Description=OtterWorks Legacy Portal (decomposition shell)
After=network.target

[Service]
Type=simple
User=legacyportal
WorkingDirectory=/opt/legacy-portal
EnvironmentFile=-/etc/legacy-portal.env
ExecStart=/usr/bin/java -jar /opt/legacy-portal/legacy-portal.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
