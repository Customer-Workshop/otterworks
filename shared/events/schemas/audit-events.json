{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OtterWorks Audit Events",
  "description": "Audit record contract published by audit-service. The same shape is accepted on POST /api/v1/audit/events and on the audit SNS topic (id/timestamp optional inbound), returned from GET /api/v1/audit/events, and written to S3 by /export and /archive.",
  "definitions": {
    "AuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "userId", "action", "resourceType", "resourceId", "timestamp"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "userId": { "type": "string" },
        "action": {
          "type": "string",
          "examples": ["create", "read", "update", "delete", "share", "login", "logout"]
        },
        "resourceType": {
          "type": "string",
          "examples": ["file", "document", "folder", "user", "permission"]
        },
        "resourceId": { "type": "string" },
        "details": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        },
        "ipAddress": { "type": ["string", "null"] },
        "userAgent": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
