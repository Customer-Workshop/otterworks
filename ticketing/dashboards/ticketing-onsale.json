    {
      "id": 14,
      "type": "timeseries",
      "title": "Payments pod restarts & outcomes",
      "description": "A payments pod deleted mid-spike loses nothing: the consumer group rebalances and un-acked records are redelivered (idempotent by orderRef).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"$token-after\",container=\"payments\"})",
          "legendFormat": "container restarts (cumulative)",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"$token-after\",pod=~\"$token-payments-.*\",phase=\"Running\"})",
          "legendFormat": "payments pods running",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
