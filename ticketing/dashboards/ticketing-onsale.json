    {
      "id": 11,
      "type": "timeseries",
      "title": "Replicas per service (0 \u2192 6)",
      "description": "Available replicas: Knative revisions (rps autoscaling, min 0 max 6), KEDA-scaled payments (Kafka lag, 0..6) and the outbox relay (0..1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(kube_deployment_status_replicas_available{namespace=\"$token-after\",deployment=~\"$token-orders-[0-9]+-deployment\"}) or on() vector(0))",
          "legendFormat": "orders",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(kube_deployment_status_replicas_available{namespace=\"$token-after\",deployment=~\"$token-seats-[0-9]+-deployment\"}) or on() vector(0))",
          "legendFormat": "seats",
          "refId": "B",
          "range": true
